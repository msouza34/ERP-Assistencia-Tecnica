# =========================
# DOMAIN / ACCESS
# =========================
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
TLS_EMAIL=admin@example.com
APP_BASE_URL=https://app.example.com
VITE_API_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Reverse proxy host ports (VPS)
HTTP_PORT=80
HTTPS_PORT=443

# Optional local debug bind (not required in production)
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8080

# =========================
# BACKEND
# =========================
SERVER_PORT=8080
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARS
JWT_EXPIRATION_MINUTES=120
TENANT_DEFAULT_ID=public
JPA_DDL_AUTO=validate

# =========================
# POSTGRESQL
# =========================
POSTGRES_DB=erp_assistencia
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_PORT=5432

# =========================
# REDIS
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD

# =========================
# AUTH / ANTI-BRUTE-FORCE
# =========================
# Use bcrypt hash (never plain password)
AUTH_USERNAME=CHANGE_ADMIN_USERNAME
AUTH_PASSWORD_HASH=CHANGE_BCRYPT_HASH
AUTH_ROLE=ADMIN
AUTH_LEGACY_ENABLED=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=15
